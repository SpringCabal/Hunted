set shell := ["bash", "-cu"]

fmt:
    cargo fmt --all

clippy:
    cargo clippy --workspace --target wasm32-unknown-unknown --release -- -D warnings

build: fmt clippy
    cargo build --workspace --target wasm32-unknown-unknown --release

copy: build
    cp target/wasm32-unknown-unknown/release/hunted_jobs_wasm.wasm ../LuaRules/wasm/hunted-jobs.wasm
    cp target/wasm32-unknown-unknown/release/hunted_rules_wasm.wasm ../LuaRules/wasm/hunted-rules.wasm
    cp target/wasm32-unknown-unknown/release/hunted_ui_wasm.wasm ../LuaUI/wasm/hunted-ui.wasm

# Host unit tests for the AI arithmetic (the `ai` crate needs no engine).
test:
    cargo test -p hunted-common --target x86_64-unknown-linux-gnu
    cargo clippy -p hunted-common --tests --target x86_64-unknown-linux-gnu -- -D warnings
